# Mode: "local" (laptop, Ollama) or "cloud" (public beta, see render.yaml)
WALKJOURNAL_MODE=local
# Where Gemma runs: "ollama" or "google" (Google AI Studio's hosted Gemma). Cloud mode defaults to google.
GEMMA_BACKEND=ollama
GOOGLE_API_KEY=
GOOGLE_GEMMA_MODEL=gemma-4-26b-a4b-it
# Password for /admin/feedback (any username). Blank = page off.
ADMIN_PASSWORD=

# Base Camp (laptop)
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e4b
SERPAPI_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional
SENTRY_DSN=
GALLERY_URL=
GALLERY_TOKEN=
# Web Push notifications. Generate keys with: python -m basecamp.app.push --generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Default verify radius in meters
PLACE_RADIUS_M=400

# MongoDB Atlas. Cloud mode stores everything in the "walk_journal" database (MONGODB_DB) when this is set;
# local mode never uses it. The Sky Gallery (gallery/) uses it too.
MONGODB_URI=
MONGODB_DB=walk_journal
